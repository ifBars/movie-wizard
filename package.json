{
  "name": "movie-wizard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "perf": "bun --tsconfig-override tsconfig.app.json scripts/performance/benchmark.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "data:enrich": "bun run scripts/movie-data/enrich-static-catalog.ts && bun run data:payloads",
    "data:languages": "bun run scripts/movie-data/backfill-catalog-languages.ts && bun run data:payloads",
    "data:metadata:local": "bun run scripts/movie-data/backfill-local-metadata.ts",
    "data:movielens": "bun run scripts/movie-data/build-movielens-neighbors.ts",
    "data:payloads": "bun run scripts/movie-data/build-catalog-payloads.ts",
    "data:seed": "bun run scripts/movie-data/enrich-static-catalog.ts --seed-only && bun run data:payloads",
    "lint": "eslint .",
    "mobile:android": "cd mobile && bun run android",
    "mobile:ios": "cd mobile && bun run ios",
    "mobile:lint": "cd mobile && bun run lint",
    "mobile:start": "cd mobile && bun run start",
    "mobile:typecheck": "cd mobile && bun run typecheck",
    "mobile:web": "cd mobile && bun run web",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.16.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
